  <div class="max-w-4xl mx-auto grid sm:grid-cols-3 gap-8 text-center mb-14">
    <div>
      <i class="fa-solid fa-envelope mb-2 block text-lg" style="color:var(--jade-bright);"></i>
      <p class="f-ui text-xs" style="letter-spacing:0.1em;color:var(--mist);">EMAIL</p>
      <a href="mailto:youremail@example.com" class="text-lg" style="color:var(--paper);">youremail@example.com</a>
    </div>
    <div>
      <i class="fa-solid fa-location-dot mb-2 block text-lg" style="color:var(--crimson);"></i>
      <p class="f-ui text-xs" style="letter-spacing:0.1em;color:var(--mist);">STATIONED AT</p>
      <p class="text-lg" style="color:var(--paper);">Lucknow University</p>
    </div>
    <div>
      <i class="fa-solid fa-compass mb-2 block text-lg" style="color:var(--gold-bright);"></i>
      <p class="f-ui text-xs" style="letter-spacing:0.1em;color:var(--mist);">CURRENTLY CHARTING</p>
      <p class="text-lg" style="color:var(--paper);">Year One, Mechanical Engineering</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs f-ui pt-8" style="border-top:1px solid rgba(255,255,255,0.06);color:rgba(175,192,217,0.6);">
    <p>&copy; 2026 Vaishnavi Adhikari. Charted from Lucknow, under one sky.</p>
    <p style="letter-spacing:0.25em;">THE CELESTIAL STRATEGIST</p>
  </div>
</footer>

<!-- ================= SECRET SCRIPT CHAMBER (easter egg) ================= -->
<button id="secretSeal" aria-label="Open the Secret Script Chamber" title="A hidden chamber...">
  <i class="fa-solid fa-seal"></i>
</button>

<div id="chamberOverlay">
  <div id="chamberScroll">
    <button id="chamberClose" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    <p class="f-ui text-xs mb-3" style="letter-spacing:0.2em;color:var(--crimson);">SECRET SCRIPT CHAMBER</p>
    <h3 id="chamberTitle" class="f-head text-xl mb-4" style="color:var(--paper);"></h3>
    <p id="chamberBody" class="text-lg leading-relaxed" style="color:var(--mist);"></p>
  </div>
</div>

<!-- ================= MODAL ================= -->
<div id="modalOverlay">
  <div id="modalPanel" class="relative">
    <button id="modalClose" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    <div class="w-12 h-12 rounded-full flex items-center justify-center mb-6" style="border:1px solid rgba(240,210,138,0.5);">
      <i id="modalIcon" class="text-xl" style="color:var(--gold-bright);"></i>
    </div>
    <h3 id="modalTitle" class="f-head text-2xl mb-5" style="color:var(--paper);"></h3>
    <p id="modalBody" class="text-lg leading-relaxed" style="color:var(--mist);"></p>
  </div>
</div>

<!-- ================= COMPANION GUIDE ================= -->
<div id="guideWrap">
  <div id="guideBubble" class="guide-bubble"></div>
  <div class="guide-avatar-wrap">
    <svg id="guideAvatar" class="guide-avatar guide-float" viewBox="0 0 100 100" role="button" tabindex="0" aria-label="Your guide">
      <ellipse cx="50" cy="90" rx="30" ry="6" fill="#000" opacity="0.3"/>
      <path d="M20 92 C15 55 25 33 50 33 C75 33 85 55 80 92Z" fill="#101B3A"/>
      <path d="M50 33 C40 33 33 44 33 57 C42 53 58 53 67 57 C67 44 60 33 50 33Z" fill="#C23B4B"/>
      <path d="M27 60c-3 12 1 22 8 26" stroke="#57B79A" stroke-width="2" fill="none" opacity="0.7"/>
      <circle cx="50" cy="24" r="14" fill="#1D0F22"/>
      <circle cx="50" cy="24" r="10" fill="#F3E8D8"/>
      <path d="M40 18c4-6 16-6 20 0" stroke="#1D0F22" stroke-width="2" fill="none"/>
      <path d="M36 12c8-8 20-8 28 0" stroke="#1D0F22" stroke-width="3" fill="none"/>
      <circle cx="50" cy="10" r="3" fill="#F0D28A"/>
    </svg>
    <span class="guide-name-tag">YOUR GUIDE</span>
  </div>
</div>

<script>
  // ---------- Starfield ----------
  const starsLayer = document.getElementById('starsLayer');
  const STAR_COUNT = window.innerWidth < 640 ? 55 : 120;
  for (let i = 0; i < STAR_COUNT; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random() * 2 + 0.6;
    s.style.width = size + 'px'; s.style.height = size + 'px';
    s.style.top = Math.random() * 100 + '%'; s.style.left = Math.random() * 100 + '%';
    s.style.animationDelay = (Math.random() * 5) + 's';
    s.style.animationDuration = (3 + Math.random() * 4) + 's';
    starsLayer.appendChild(s);
  }

  // ---------- Drifting lanterns ----------
  const driftLayer = document.getElementById('driftLayer');
  const lanternSVG = (w) => `<svg width="${w}" height="${w*1.3}" viewBox="0 0 40 52" fill="none">
      <ellipse cx="20" cy="8" rx="9" ry="3" fill="#C9A24B"/>
      <path d="M6 10c0 18 6 28 14 30 8-2 14-12 14-30-4 4-24 4-28 0Z" fill="#C23B4B" opacity="0.9"/>
      <path d="M6 10c0 18 6 28 14 30 8-2 14-12 14-30" stroke="#F0D28A" stroke-width="0.6" opacity="0.6" fill="none"/>
      <rect x="18" y="40" width="4" height="8" fill="#8A6B2E"/>
    </svg>`;
  const LANTERN_COUNT = window.innerWidth < 640 ? 4 : 7;
  for (let i = 0; i < LANTERN_COUNT; i++) {
    const l = document.createElement('div');
    l.className = 'lantern-drift';
    const w = 26 + Math.random() * 22;
    l.style.left = (5 + Math.random() * 90) + '%';
    l.style.animationDuration = (16 + Math.random() * 10) + 's';
    l.style.animationDelay = (Math.random() * 14) + 's';
    l.innerHTML = lanternSVG(w);
    driftLayer.appendChild(l);
  }

  // ---------- Mobile menu ----------
  const menuBtn = document.getElementById('menuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  menuBtn.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('flex');
    mobileMenu.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuBtn.innerHTML = isOpen ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
  });
  mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    mobileMenu.classList.add('hidden'); mobileMenu.classList.remove('flex');
    menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>'; menuBtn.setAttribute('aria-expanded', 'false');
  }));

  // ---------- Reveal on scroll ----------
  const revealEls = document.querySelectorAll('[data-reveal]');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => revealObserver.observe(el));

  // ---------- Ember burst on seal buttons ----------
  document.querySelectorAll('.btn-seal').forEach(btn => {
    const burst = btn.querySelector('.ember-burst');
    btn.addEventListener('mouseenter', () => {
      if (!burst) return;
      burst.innerHTML = '';
      for (let i = 0; i < 10; i++) {
        const e = document.createElement('span');
        e.className = 'ember';
        const angle = Math.random() * Math.PI * 2;
        const dist = 24 + Math.random() * 24;
        e.style.setProperty('--ex', Math.cos(angle) * dist + 'px');
        e.style.setProperty('--ey', Math.sin(angle) * dist + 'px');
        e.style.left = (30 + Math.random() * 40) + '%';
        e.style.top = '50%';
        e.style.animationDelay = (Math.random() * 0.15) + 's';
        burst.appendChild(e);
      }
    });
  });

  // ---------- Only one <details> open at a time within its grid ----------
  document.querySelectorAll('details.parchment').forEach(d => {
    d.addEventListener('toggle', () => {
      if (d.open) {
        document.querySelectorAll('details.parchment').forEach(other => {
          if (other !== d) other.open = false;
        });
      }
    });
  });

  // ---------- Modal (Scroll Vault) ----------
  const modalOverlay = document.getElementById('modalOverlay');
  const modalTitle = document.getElementById('modalTitle');
  const modalBody = document.getElementById('modalBody');
  const modalIcon = document.getElementById('modalIcon');
  const modalClose = document.getElementById('modalClose');

  document.querySelectorAll('.scroll-card').forEach(card => {
    card.addEventListener('click', () => {
      modalTitle.textContent = card.getAttribute('data-modal-title');
      modalBody.textContent = card.getAttribute('data-modal-body');
      modalIcon.className = card.getAttribute('data-modal-icon') + ' text-xl';
      modalOverlay.classList.add('open');
    });
  });
  function closeModal() { modalOverlay.classList.remove('open'); }
  modalClose.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeModal(); closeChamber(); } });

  // ---------- Secret Script Chamber ----------
  const secretInsights = [
    {
      title: "On Color Theory",
      body: "Warm light (amber, crimson) reads as memory; cool light (jade, indigo) reads as distance. Every frame I grade is really just deciding how close I want the audience to feel to what they're watching."
    },
    {
      title: "On Astronomy",
      body: "Light from some of the stars overhead tonight left its source before either of us was born. Looking up is, technically, always looking backward — which might be the most honest thing the sky ever does."
    },
    {
      title: "A Small Poem",
      body: "\u201cI keep a lantern lit for logic,\nand one for longing too —\nboth burn the same amber,\nboth answer to the same wind.\u201d"
    }
  ];
  const secretSeal = document.getElementById('secretSeal');
  const chamberOverlay = document.getElementById('chamberOverlay');
  const chamberTitle = document.getElementById('chamberTitle');
  const chamberBody = document.getElementById('chamberBody');
  const chamberClose = document.getElementById('chamberClose');

  secretSeal.addEventListener('click', () => {
    const pick = secretInsights[Math.floor(Math.random() * secretInsights.length)];
    chamberTitle.textContent = pick.title;
    chamberBody.textContent = pick.body;
    chamberOverlay.classList.add('open');
  });
  function closeChamber() { chamberOverlay.classList.remove('open'); }
  chamberClose.addEventListener('click', closeChamber);
  chamberOverlay.addEventListener('click', (e) => { if (e.target === chamberOverlay) closeChamber(); });

  // ---------- Guide companion ----------
  const guideBubble = document.getElementById('guideBubble');
  const guideAvatar = document.getElementById('guideAvatar');
  const guideSections = document.querySelectorAll('[data-guide]');
  let guideTimeout;

  function showGuideMessage(text) {
    guideBubble.textContent = text;
    guideBubble.classList.add('show');
    clearTimeout(guideTimeout);
    guideTimeout = setTimeout(() => guideBubble.classList.remove('show'), 5000);
  }

  const guideObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) showGuideMessage(entry.target.getAttribute('data-guide'));
    });
  }, { threshold: 0.55 });
  guideSections.forEach(s => guideObserver.observe(s));

  guideAvatar.addEventListener('click', () => {
    const lines = [
      "There's a hidden seal in the corner of this page. Strategists always look twice.",
      "Every scroll here opens into something longer — that's rather the point of scrolls.",
      "Thank you for staying this long in my little cosmos."
    ];
    showGuideMessage(lines[Math.floor(Math.random() * lines.length)]);
  });
  guideAvatar.addEventListener('keypress', (e) => { if (e.key === 'Enter') guideAvatar.click(); });

  window.addEventListener('load', () => setTimeout(() => showGuideMessage(document.querySelector('#top').getAttribute('data-guide')), 900));

  // ---------- Contact form -> mailto, with a lantern-release moment ----------
  const form = document.getElementById('signalForm');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const message = document.getElementById('message').value.trim();
    const subject = encodeURIComponent('A transmission from ' + name);
    const body = encodeURIComponent(message + '\n\n— ' + name + ' (' + email + ')');

    const l = document.createElement('div');
    l.className = 'lantern-drift';
    l.style.left = '50%';
    l.style.animationDuration = '3.4s';
    l.innerHTML = lanternSVG(46);
    document.body.appendChild(l);
    setTimeout(() => l.remove(), 3600);

    setTimeout(() => {
      window.location.href = `mailto:youremail@example.com?subject=${subject}&body=${body}`;
    }, 400);
  });
</script>

</body>
</html>
